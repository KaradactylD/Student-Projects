<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/dash_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/dashboardToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ToolbarPopupTheme" >

        <TextView
            android:id="@+id/customTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="Slasher Tycoon"
            android:textSize="52sp"
            android:textColor="#FFFFFF"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:fontFamily="@font/slash_font"
            android:gravity="center"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" >


        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="1dp"
            android:gravity="center_horizontal">

            <ProgressBar
                android:id="@+id/xpProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/xpColor"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="10dp"
                android:backgroundTint="@android:color/darker_gray"/>

            <TextView
                android:id="@+id/xpTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XP: 0 / 0"
                android:textColor="@color/xpColor"
                android:textSize="25sp"
                android:layout_marginTop="2dp"
                android:layout_gravity="center" />

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_gravity="center"
                android:layout_marginTop="1dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageButton
                            android:id="@+id/buttonFreddy"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/freddy_btn"
                            android:background="@android:color/transparent"
                            android:contentDescription="Freddy" />
                        <ImageView
                            android:id="@+id/iconFreddyAlert"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:src="@drawable/ic_exclamation"
                            android:visibility="gone"
                            android:alpha="0.9" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageButton
                            android:id="@+id/buttonJason"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/jason_btn"
                            android:background="@android:color/transparent"
                            android:contentDescription="Jason" />
                        <ImageView
                            android:id="@+id/iconJasonAlert"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:src="@drawable/ic_exclamation"
                            android:visibility="gone"
                            android:alpha="0.9" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageButton
                            android:id="@+id/buttonScream"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/ghostface_btn"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:background="@android:color/transparent"
                            android:contentDescription="Ghostface" />
                        <ImageView
                            android:id="@+id/iconScreamAlert"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:src="@drawable/ic_exclamation"
                            android:visibility="gone"
                            android:alpha="0.9" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageButton
                            android:id="@+id/buttonVictor"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:src="@drawable/victor_btn"
                            android:background="@android:color/transparent"
                            android:contentDescription="Victor Crowley" />
                        <ImageView
                            android:id="@+id/iconVictorAlert"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:src="@drawable/ic_exclamation"
                            android:visibility="gone"
                            android:alpha="0.9" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>
            </GridLayout>

            <GridLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins"
                android:useDefaultMargins="true"
                android:layout_gravity="center"
                android:layout_marginTop="12dp">

            <androidx.cardview.widget.CardView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@android:color/transparent">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:id="@+id/buttonJigsaw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/jigsaw_btn"
                        android:scaleType="fitCenter"
                        android:adjustViewBounds="true"
                        android:background="@android:color/transparent"
                        android:contentDescription="Jigsaw" />
                    <ImageView
                        android:id="@+id/iconJigsawAlert"
                        android:layout_width="27dp"
                        android:layout_height="27dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:src="@drawable/ic_exclamation"
                        android:visibility="gone"
                        android:alpha="0.9" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
                <GridLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <ImageButton
                            android:id="@+id/buttonCandyman"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:src="@drawable/candyman_btn"
                            android:scaleType="fitCenter"
                            android:adjustViewBounds="true"
                            android:background="@android:color/transparent"
                            android:contentDescription="Candyman" />
                        <ImageView
                            android:id="@+id/iconCandymanAlert"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="4dp"
                            android:src="@drawable/ic_exclamation"
                            android:visibility="gone"
                            android:alpha="0.9" />
                    </FrameLayout>
                </androidx.cardview.widget.CardView>

            </GridLayout>

        </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="1dp"
                android:layout_marginBottom="1dp">

                <TextView
                    android:id="@+id/textMoneyDisplay"
                    android:layout_width="203dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="1dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/slash_font"
                    android:gravity="start|center_vertical"
                    android:maxLines="1"
                    android:padding="3dp"
                    android:text="💰 $0"
                    android:textColor="#FFEB3B"
                    android:textSize="53sp" />

                <Button
                    android:id="@+id/buttonNeedCash"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Need Extra Cash?"
                    android:textSize="29sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#003366"
                    android:paddingStart="24dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:stateListAnimator="@null"
                    android:outlineProvider="none"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
