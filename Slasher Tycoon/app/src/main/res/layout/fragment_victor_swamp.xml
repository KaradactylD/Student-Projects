<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.VictorSwampFragment">

    <ImageView
        android:id="@+id/victorBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/victor_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />
    <FrameLayout
        android:id="@+id/fireflyContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/visitorTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Visitors: 0"
                    android:textColor="#FFE082"
                    android:textSize="40sp"
                    android:shadowColor="#000000"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/killsTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kills Today: 0"
                    android:textColor="#FFE082"
                    android:textSize="40sp"
                    android:shadowColor="#000000"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="6"
                    android:gravity="center"/>

            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp">

                <!-- Outer glow layer -->
                <TextView
                    android:id="@+id/swampTitleShadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honey Island \n   Swamp"
                    android:textSize="65sp"
                    android:textStyle="bold"
                    android:textColor="#FFFF33"
                    android:shadowColor="#FFFF33"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:fontFamily="@font/slash_font"
                    android:letterSpacing="0.07" />
                <!-- Black outline layer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honey Island \n   Swamp"
                    android:textSize="65sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:shadowColor="#000000"
                    android:shadowDx="4"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:fontFamily="@font/slash_font"
                    android:letterSpacing="0.07" />
                <!-- Fill layer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honey Island \n   Swamp"
                    android:textSize="65sp"
                    android:textStyle="bold"
                    android:textColor="#C22E2E"
                    android:letterSpacing="0.07"
                    android:fontFamily="@font/slash_font" />

            </FrameLayout>

            <TextView
                android:id="@+id/taskBannerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK GOES HERE"
                android:textSize="40sp"
                android:textColor="#E3BEBE"
                android:layout_marginTop="25dp"
                android:padding="8dp"
                android:gravity="center" />

            <Button
                android:id="@+id/useItemButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Item"
                android:backgroundTint="#37503F"
                android:textColor="#FFE082"
                android:textSize="30sp"
                android:layout_marginTop="25dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="150dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="12dp">

        <Button
            android:id="@+id/buttonStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 Open Victor's Store"
            android:backgroundTint="#37503F"
            android:textColor="#FFE082"
            android:textSize="30sp"/>

        <TextView
            android:id="@+id/textMoneyDisplay"
            android:layout_width="203dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/slash_font"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:padding="3dp"
            android:text="$0"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:textColor="#FFE082"
            android:textSize="69sp" />
    </LinearLayout>

</FrameLayout>