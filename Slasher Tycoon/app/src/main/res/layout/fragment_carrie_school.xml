<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.CarrieSchoolFragment">

    <ImageView
        android:id="@+id/carrieBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/carrie_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <ImageView
        android:id="@+id/hangingLightGlow"
        android:layout_width="80dp"
        android:layout_height="60dp"
        android:src="@drawable/light_glow"
        android:layout_marginTop="65dp"
        android:layout_marginStart="201dp"
        android:contentDescription="@null" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="5dp"
                android:gravity="center_horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/visitorTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Visitors: 0"
                    android:textColor="#FF5E5B"
                    android:textSize="40sp"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/killsTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kills Today: 0"
                    android:textColor="#FF5E5B"
                    android:textSize="40sp"
                    android:gravity="center"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp">

                <!-- Black outline layer -->
                <TextView
                    android:id="@+id/carrieTitleShadow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ewen \n High School"
                    android:textSize="65sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#80000000"
                    android:shadowColor="#80000000"
                    android:shadowDx="5"
                    android:shadowDy="0"
                    android:shadowRadius="15"
                    android:fontFamily="@font/slash_font" />

                <!-- Fill layer -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ewen \n High School"
                    android:textSize="65sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.09"
                    android:textColor="#A4B88A"
                    android:fontFamily="@font/slash_font" />

                <ImageView
                    android:id="@+id/bloodDrip"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="-8dp"
                    android:src="@drawable/blood_drip"
                    android:contentDescription="@null" />
                <ImageView
                    android:id="@+id/bloodDrip2"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="92dp"
                    android:layout_marginStart="11dp"
                    android:src="@drawable/blood_drip"
                    android:contentDescription="@null" />
            </FrameLayout>

            <TextView
                android:id="@+id/taskBannerTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TASK GOES HERE"
                android:textSize="40sp"
                android:textColor="#F8D2B4"
                android:shadowColor="#1C1C1C"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:layout_marginTop="25dp"
                android:padding="8dp"
                android:gravity="center" />

            <Button
                android:id="@+id/useItemButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use Item"
                android:backgroundTint="#3E1C2D"
                android:textColor="#FFE3B3"
                android:shadowColor="#2B2D30"
                android:shadowDx="5"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:textSize="30sp"
                android:layout_marginTop="25dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="150dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="12dp">

        <Button
            android:id="@+id/buttonStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛒 Open Carrie's Store"
            android:backgroundTint="#3E1C2D"
            android:textColor="#FFE3B3"
            android:shadowColor="#1C1C1C"
            android:shadowDx="5"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textSize="30sp"/>

        <TextView
            android:id="@+id/textMoneyDisplay"
            android:layout_width="203dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/slash_font"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:padding="3dp"
            android:text="$0"
            android:shadowColor="#1C1C1C"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="12"
            android:textColor="#D96E30"
            android:textSize="69sp" />
    </LinearLayout>

</FrameLayout>